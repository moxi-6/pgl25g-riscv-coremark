# ---- RGB LCD touch panel (GT9147/GT9xx, I2C) ----------------------------
# Pinout from the ATK-L50 development guide ch.38: the panel's 4-wire touch
# header maps T_SCK->SCL, T_MOSI->SDA, T_CS->RESET, T_PEN->INT.
# The SDA/SCL pull-ups live on the LCD module; the FPGA only pulls low.
define_attribute {p:tp_scl} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:tp_scl} {PAP_IO_LOC} {L4}
define_attribute {p:tp_scl} {PAP_IO_VCCIO} {3.3}
define_attribute {p:tp_scl} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:tp_scl} {PAP_IO_DRIVE} {4}
define_attribute {p:tp_scl} {PAP_IO_NONE} {TRUE}
define_attribute {p:tp_scl} {PAP_IO_SLEW} {SLOW}
define_attribute {p:tp_sda} {PAP_IO_DIRECTION} {INOUT}
define_attribute {p:tp_sda} {PAP_IO_LOC} {K3}
define_attribute {p:tp_sda} {PAP_IO_VCCIO} {3.3}
define_attribute {p:tp_sda} {PAP_IO_STANDARD} {LVCMOS33}
