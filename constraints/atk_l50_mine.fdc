create_generated_clock -name {lcd_pixel} -source [get_ports {sys_clk}] -divide_by 2 [get_ports {lcd_pclk}]
set_output_delay -clock [get_clocks {lcd_pixel}] -max 5.000 [get_ports {lcd_de lcd_rgb[*]}]
set_output_delay -clock [get_clocks {lcd_pixel}] -min -2.000 [get_ports {lcd_de lcd_rgb[*]}]

